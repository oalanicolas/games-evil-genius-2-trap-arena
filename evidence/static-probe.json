    {
      "file": "text/pc/objective/objective.asr_en",
      "sha256": "966113bbb8d7f2dc8ea79924eb0b6155d2228eb232dddb3a8e80d372be2755fe",
      "total_entries": 3358,
      "selected": [
        {
          "index": 2646,
          "localization_hash": 2791158678,
          "text": "The Forces of Justice desperately want to know what you're up to on that Island. With a gentle nudge you might be able to convince them to send a fresh wave of Investigators.",
          "classification": "extracted_data_not_runtime"
        },
        {
          "index": 2650,
          "localization_hash": 1497474180,
          "text": "The Forces of Justice desperately want to know what you're up to on that Island. With a gentle nudge you might be able to convince them to send an experienced wave of Investigators.",
          "classification": "extracted_data_not_runtime"
        },
        {
          "index": 2654,
          "localization_hash": 876111311,
          "text": "The Forces of Justice desperately want to know what you're up to on that Island. With a gentle nudge you might be able to convince them to send a veteran wave of Investigators.",
          "classification": "extracted_data_not_runtime"
        },
        {
          "index": 2658,
          "localization_hash": 1174903654,
          "text": "Having amassed your wealth by stealing it, the Forces of Justice want to steal it back. A wave of fresh of Rogues is waiting for a signal to begin, send it for them.",
          "classification": "extracted_data_not_runtime"
        },
        {
          "index": 2662,
          "localization_hash": 3054557268,
          "text": "Having amassed your wealth by stealing it, the Forces of Justice want to steal it back. A wave of experienced of Rogues is waiting for a signal to begin, send it for them.",
          "classification": "extracted_data_not_runtime"
        },
        {
          "index": 2666,
          "localization_hash": 3554823583,
          "text": "Having amassed your wealth by stealing it, the Forces of Justice want to steal it back. A wave of veteran of Rogues is waiting for a signal to begin, send it for them.",
          "classification": "extracted_data_not_runtime"
        },
        {
          "index": 2670,
          "localization_hash": 2907891221,
          "text": "Whatever you're building, there's a very good chance the Forces of Justice want to see it broken, on fire, or reduced to little more than scrap. A fresh wave of Saboteurs is waiting to invade your Lair at the slightest provocation.",
          "classification": "extracted_data_not_runtime"
        },
        {
          "index": 2674,
          "localization_hash": 2008298307,
          "text": "Whatever you're building, there's a very good chance the Forces of Justice want to see it broken, on fire, or reduced to little more than scrap. An experienced wave of Saboteurs is waiting to invade your Lair at the slightest provocation.",
          "classification": "extracted_data_not_runtime"
        },
        {
          "index": 2678,
          "localization_hash": 992843854,
          "text": "Whatever you're building, there's a very good chance the Forces of Justice want to see it broken, on fire, or reduced to little more than scrap. A veteran wave of Saboteurs is waiting to invade your Lair at the slightest provocation.",
          "classification": "extracted_data_not_runtime"
        },
        {
          "index": 2682,
          "localization_hash": 1381016846,
          "text": "The Forces of Justice are tired of your blatant criminal activity. They have prepared a wave of fresh Soldiers that is itching to strike, all it will take is a slight prod to set them off.",
          "classification": "extracted_data_not_runtime"
        },
        {
          "index": 2686,
          "localization_hash": 3560839164,
          "text": "The Forces of Justice are tired of your blatant criminal activity. They have prepared a wave of experienced Soldiers that is itching to strike, all it will take is a slight prod to set them off.",
          "classification": "extracted_data_not_runtime"
        },
        {
