  "native_text": [
    {
      "file": "text/pc/furniture/furniture.asr_en",
      "sha256": "03a7afefc5eab00ec5bddf9f75289e7805070eb4cbdf3298bc67761ce4073880",
      "total_entries": 1103,
      "selected": [
        {
          "index": 182,
          "localization_hash": 315182526,
          "text": "This door has lasers. What more could you want? Effective against Rogues, but Saboteurs can easily break it.",
          "classification": "extracted_data_not_runtime"
        },
        {
          "index": 693,
          "localization_hash": 2525149811,
          "text": "\"Ha! It hit him in the face. Do it again! Do it again!\" - Everyone. Single target trap, ideal for breaking up groups of Agents.",
          "classification": "extracted_data_not_runtime"
        },
        {
          "index": 694,
          "localization_hash": 2525443693,
          "text": "Boxing Glove",
          "classification": "extracted_data_not_runtime"
        },
        {
          "index": 695,
          "localization_hash": 1350136128,
          "text": "Trap your enemies within a prison of soap and water. Science will cause them to float, helping other traps move your now weightless victim.",
          "classification": "extracted_data_not_runtime"
        },
        {
          "index": 696,
          "localization_hash": 1350430010,
          "text": "Bubble Cannon",
          "classification": "extracted_data_not_runtime"
        },
        {
          "index": 699,
          "localization_hash": 834108290,
          "text": "This trap will truly blow your enemies away.",
          "classification": "extracted_data_not_runtime"
        },
        {
          "index": 700,
          "localization_hash": 834402172,
          "text": "Giant Fan",
          "classification": "extracted_data_not_runtime"
        },
        {
          "index": 711,
          "localization_hash": 3232352348,
          "text": "The coolest cats won't be able to resist the mind bending beats or captivating rhythms. The lasers will do the rest.",
          "classification": "extracted_data_not_runtime"
        },
        {
          "index": 713,
          "localization_hash": 1269595392,
          "text": "Have you ever wanted to defend your Lair with a grid of searingly powerful lasers? Anyway, here's Laser Wall.",
          "classification": "extracted_data_not_runtime"
        },
        {
          "index": 714,
          "localization_hash": 1269889274,
          "text": "Laser Wall",
          "classification": "extracted_data_not_runtime"
        },
        {
          "index": 727,
          "localization_hash": 2666018957,
          "text": "Your workers got the idea for this one from a cartoon they saw on early morning EG-TV.",
          "classification": "extracted_data_not_runtime"
        },
        {
          "index": 728,
          "localization_hash": 2666312839,
          "text": "Slippery Floor",
          "classification": "extracted_data_not_runtime"
        }
      ]
    },
    {
